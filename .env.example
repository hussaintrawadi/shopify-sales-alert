# Copy to .env for local runs:  cp .env.example .env
# python -m sales_alert reads .env by itself. Real environment variables win.
# On GitHub, put these in Settings > Secrets and variables > Actions instead.

# ---- Shopify (required) ----------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A: a permanent Admin API token (shpat_...), or one from scripts/get_access_token.py
SHOPIFY_ACCESS_TOKEN=
# Option B: a Dev Dashboard app on a store in your own organization
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ---- Email (required unless DRY_RUN=true) ----------------------------------
EMAIL_PROVIDER=resend            # resend, brevo or smtp
EMAIL_API_KEY=                   # for resend or brevo
EMAIL_FROM=Sales Report <reports@yourdomain.com>
EMAIL_TO=you@yourdomain.com, team@yourdomain.com

# Only for EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587                    # 465 for SSL, 587 for STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Optional --------------------------------------------------------------
DRY_RUN=true                     # write email-preview.html instead of sending
# REPORT_DATE=2026-09-27         # report this day instead of yesterday
# STORE_NAME=                    # defaults to the name in Shopify
# REPORT_TIMEZONE=Asia/Kolkata   # defaults to the store's timezone
# BRAND_COLOR=#1f2937
# GROUP_BY=product_type          # product_type, vendor, rules or none
# CATEGORY_RULES_FILE=categories.yaml
# TOP_N=10                       # rows in each top-sellers table
# INCLUDE_TEST_ORDERS=false
# SEND_WHEN_NO_ORDERS=true
# SHOPIFY_API_VERSION=2026-07
